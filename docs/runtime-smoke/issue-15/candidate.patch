@@ -0,0 +1,29 @@
+import json
+from pathlib import Path
+import subprocess
+import sys
+import unittest
+
+
+SCRIPT = Path(__file__).with_name("spawn-audit.py")
+
+
+class SpawnAuditInvalidInputTests(unittest.TestCase):
+    def test_malformed_json_returns_error_object_and_status_one(self):
+        result = subprocess.run(
+            [sys.executable, "-B", str(SCRIPT)],
+            input="{\n",
+            text=True,
+            capture_output=True,
+            check=False,
+        )
+
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stderr, "")
+        output = json.loads(result.stdout)
+        self.assertIsInstance(output, dict)
+        self.assertTrue(output.get("error"))
+
+
+if __name__ == "__main__":
+    unittest.main()
