@@ -0,0 +1,28 @@
+import json
+from pathlib import Path
+import subprocess
+import sys
+import unittest
+
+
+SCRIPT = Path(__file__).with_name("spawn-audit.py")
+
+
+class SpawnAuditCliTests(unittest.TestCase):
+    def test_malformed_json_emits_error_and_exits_one(self):
+        result = subprocess.run(
+            [sys.executable, str(SCRIPT)],
+            input="{malformed\n",
+            text=True,
+            capture_output=True,
+            check=False,
+            env={"PYTHONDONTWRITEBYTECODE": "1"},
+        )
+
+        self.assertEqual(result.returncode, 1, result)
+        payload = json.loads(result.stdout)
+        self.assertTrue(payload.get("error"))
+
+
+if __name__ == "__main__":
+    unittest.main()
