+import json
+from pathlib import Path
+import subprocess
+import sys
+import unittest
+
+
+CLI = Path(__file__).with_name("spawn-audit.py")
+
+
+class SpawnAuditInvalidJsonTests(unittest.TestCase):
+    def test_invalid_json_returns_error_and_failure_status(self):
+        result = subprocess.run(
+            [sys.executable, str(CLI)],
+            input="{",
+            text=True,
+            capture_output=True,
+            check=False,
+        )
+
+        self.assertEqual(result.returncode, 1)
+        output = json.loads(result.stdout)
+        self.assertIsInstance(output, dict)
+        self.assertTrue(output.get("error"))
+
+
+if __name__ == "__main__":
+    unittest.main()
